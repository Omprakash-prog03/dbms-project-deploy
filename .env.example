# Copy to .env, then set a random SECRET_KEY for persistent sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
SECRET_KEY=
DB_ENGINE=sqlite
SQLITE_PATH=sims_embedded.db
PORT=5000

# Enable the seeded demo account shortcuts only for local demonstrations.
DEMO_MODE=false
COOKIE_SECURE=false
# Enable only for an HTTPS iframe preview (partitioned, secure cookies).
EMBEDDED_PREVIEW=false

# Optional MySQL 8 connection (DB_ENGINE=mysql fails closed if unavailable)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sims_app
DB_PASSWORD=
DB_NAME=sims_db

# Required only for docker compose (choose your own, never commit it):
MYSQL_ROOT_PASSWORD=

# Trust a forwarded client IP/protocol only behind a known hosting proxy.
TRUSTED_PROXY_HOPS=0

# The supreme administrator: their own account, signed in at /supreme.
# Leave as om-2026 (the account scripts/setup_admins.py creates) unless you rename it.
OWNER_USERNAME=om-2026
# Administrators who sign in with a password only. Everyone else must also type
# a one-time code the supreme administrator issues from /owner.
OTP_EXEMPT_ADMINS=omprakash
